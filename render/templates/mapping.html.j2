{# Mapping repensé (v1.8) : trois chiffres décisifs, frise à l'échelle du temps, étapes, Contacts / PCI / Actions.
   Page 1280 × 720 px. Le rouge = danger, l'orange = à compléter ; chaque couleur est doublée d'un symbole. #}
{% set x = v.v2 %}
{% set per = v.rows[0]|length if v.rows and v.rows[0]|length else 1 %}
{% set two = v.rows|length > 1 %}
<style>
.mp { background: #F4F2EC; color: #14213D; }
.mp-head { position: absolute; left: 0; right: 0; top: 0; height: 70px; background: #12213B; color: #F7F5F0;
  display: flex; align-items: center; padding: 0 22px; gap: 16px; }
.mp-ttl { min-width: 0; flex: 1 1 auto; }
.mp-t1 { font-size: 20px; font-weight: 800; white-space: nowrap; overflow: hidden; }
.mp-t2 { font-size: 11.5px; color: #C9D3E2; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mp-hero { display: flex; gap: 8px; flex: none; }
.mp-k { border-radius: 9px; padding: 6px 12px; width: 168px; }
.mp-k .l { font-size: 8.5px; font-weight: 800; letter-spacing: .9px; text-transform: uppercase; opacity: .9; }
.mp-k .v { font-size: 19px; font-weight: 800; line-height: 1.15; margin-top: 1px; white-space: nowrap; overflow: hidden; }
.mp-k .s { font-size: 9px; opacity: .92; margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mp-tri { position: absolute; left: 0; right: 0; top: 70px; height: 4px; display: flex; }
.mp-tri i { flex: 1; }
.mp-dates { position: absolute; left: 0; right: 0; top: 74px; height: 28px; background: #FFFDF9; border-bottom: 1px solid #E2DCCF;
  display: flex; align-items: center; gap: 11px; padding: 0 22px; font-size: 10.5px; color: #435066; white-space: nowrap; }
.mp-dates b { color: #14213D; }
.mp-miss { margin-left: auto; background: #FFF1DC; color: #8A4B00; border: 1px solid #F0C78A; border-radius: 999px;
  padding: 3px 10px; font-weight: 700; font-size: 10.5px; overflow: hidden; text-overflow: ellipsis; }
.mp-wrap { position: absolute; left: 0; right: 0; top: 102px; bottom: 0; padding: 8px 22px 6px; display: flex; flex-direction: column; gap: 7px; }
.mp-sec { font-size: 9.5px; font-weight: 800; letter-spacing: 1.1px; text-transform: uppercase; color: #12213B; display: flex; gap: 10px; align-items: baseline; }
.mp-sec small { font-size: 9px; font-weight: 600; letter-spacing: 0; text-transform: none; color: #7A8496; }
.mp-tl { position: relative; height: 66px; flex: none; margin: 0 4px; }
.mp-band { position: absolute; top: 4px; height: 20px; border-radius: 4px; font-size: 9.5px; font-weight: 700; display: flex;
  align-items: center; padding: 0 6px; white-space: nowrap; overflow: hidden; }
.mp-gap { position: absolute; top: 28px; height: 14px; border: 1.5px dashed #C76A00; border-radius: 4px; background: #FFF6E8;
  color: #8A4B00; font-size: 8.5px; font-weight: 700; display: flex; align-items: center; justify-content: center; white-space: nowrap; overflow: hidden; }
.mp-line { position: absolute; left: 0; right: 0; top: 49px; height: 2px; background: #C9C2B3; }
.mp-dot { position: absolute; top: 44px; width: 11px; height: 11px; margin-left: -5.5px; border-radius: 50%; border: 2px solid #F4F2EC; }
.mp-tick { position: absolute; top: 55px; font-size: 8.5px; color: #7A8496; transform: translateX(-50%); white-space: nowrap; }
.mp-rep { position: absolute; top: 0; height: 52px; border-left: 1.5px solid #12213B; }
.mp-rep span { position: absolute; top: -1px; left: 3px; font-size: 8px; font-weight: 800; color: #12213B; background: #F4F2EC; padding: 0 2px; white-space: nowrap; }
.mp-cards { flex: 1 1 auto; min-height: 0; display: grid; gap: 6px; }
.mp-c { background: #FFFDF9; border: 1px solid #E2DCCF; border-radius: 8px; padding: 6px 7px 7px; display: flex; flex-direction: column;
  gap: 2px; min-width: 0; min-height: 0; overflow: hidden; }
.mp-c.inc { border-style: dashed; }
.mp-c .cb { flex: 1 1 auto; min-height: 0; overflow: hidden; font-size: 11px; display: flex; flex-direction: column; gap: .18em; }
.mp-c .d { font-size: .92em; font-weight: 800; color: #3E6FA8; line-height: 1.2; }
.mp-c .d small { color: #7A8496; font-weight: 700; margin-left: .3em; }
.mp-c .p { font-size: 1em; font-weight: 700; line-height: 1.2; }
.mp-c .e { font-size: .92em; color: #435066; line-height: 1.25; }
.mp-c .x { font-size: .82em; color: #5B6577; line-height: 1.25; }
.mp-c .q { font-size: .8em; color: #8A4B00; font-weight: 700; }
.mp-c .ch { font-size: .78em; color: #8E1F24; font-weight: 700; }
.mp-c .ch.info { color: #435066; font-weight: 600; }
.mp-pill { flex: none; color: #fff; font-size: {{ 8.5 if two else 9.5 }}px; font-weight: 800; border-radius: 5px; padding: {{ 2 if two else 3 }}px 4px;
  text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mp-bottom { flex: none; height: {{ 168 if two else 214 }}px; display: grid; grid-template-columns: 1.25fr 1fr 1.25fr; gap: 9px; }
.mp-box { background: #FFFDF9; border: 1px solid #E2DCCF; border-radius: 9px; padding: 8px 12px; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.mp-box .mp-sec { justify-content: space-between; margin-bottom: 5px; }
.mp-body { flex: 1 1 auto; min-height: 0; overflow: hidden; font-size: 11px; display: flex; flex-direction: column; gap: .32em; }
.mp-row { display: flex; align-items: center; gap: .7em; line-height: 1.2; }
.mp-row .n { width: 40%; flex: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mp-bar { flex: 1; height: .8em; background: #EEE9DE; border-radius: .4em; overflow: hidden; }
.mp-bar i { display: block; height: 100%; }
.mp-row .v { flex: none; min-width: 6.8em; text-align: right; font-weight: 800; white-space: nowrap; }
.mp-todo { color: #8A4B00; font-weight: 700; }
.mp-st { flex: none; font-size: .88em; font-weight: 800; border-radius: .4em; padding: .2em .55em; white-space: nowrap; }
.mp-note { color: #435066; font-size: .92em; line-height: 1.3; }
.mp-foot { flex: none; height: 16px; display: flex; justify-content: space-between; font-size: 8.5px; color: #7A8496; white-space: nowrap; gap: 12px; }
.mp-foot b { color: #12213B; }
</style>

<div class="page mapping mp">
  <div class="mp-head">
    <div class="mp-ttl">
      <div class="mp-t1" data-fit="12" data-max="20">{{ x.titre }}</div>
      <div class="mp-t2">{{ x.sous }}</div>
    </div>
    <div class="mp-hero">
      {% for k in x.hero %}
      <div class="mp-k" style="background: {{ k.bg }}; color: {{ k.fg }};">
        <div class="l">{{ k.k }}</div><div class="v" data-fit="11" data-max="19">{{ k.v }}</div><div class="s">{{ k.s }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="mp-tri"><i style="background:#1D5FAF"></i><i style="background:#C8202A"></i><i style="background:#F2B705"></i></div>
  <div class="mp-dates">
    {% for d in x.dates %}<span>{{ d.k }} <b>{{ d.v }}</b>{% if d.x %} {{ d.x }}{% endif %}</span>{% endfor %}
    {% if x.manque %}<span class="mp-miss">? {{ x.manque|join(' · ') }}</span>{% endif %}
  </div>

  <div class="mp-wrap">
    <div class="mp-sec">Chronologie à l’échelle du temps
      {% if x.frise and x.frise.adapte %}<small>les jours où plusieurs étapes se suivent sont agrandis</small>{% endif %}</div>
    {% if x.frise %}
    <div class="mp-tl">
      {% for b in x.frise.bandes %}<div class="mp-band" style="left: {{ b.l }}%; width: calc({{ b.w }}% - 2px); background: {{ b.bg }}; color: {{ b.fg }};" title="{{ b.t }}">{{ b.t }}</div>{% endfor %}
      {% if x.frise.trou %}<div class="mp-gap" style="left: {{ x.frise.trou.l }}%; width: calc({{ x.frise.trou.w }}% - 2px);">{{ x.frise.trou.t }}</div>{% endif %}
      <div class="mp-line"></div>
      {% for r in x.frise.reperes %}<div class="mp-rep" style="left: {{ r.x }}%;"><span>{{ r.t }}</span></div>{% endfor %}
      {% for p in x.frise.points %}<div class="mp-dot" style="left: {{ p.x }}%; background: {{ p.c }};" title="{{ p.t }}"></div>{% endfor %}
      {% for t in x.frise.ticks %}<div class="mp-tick" style="left: {{ t.x }}%;">{{ t.t }}</div>{% endfor %}
    </div>
    {% else %}
    <div class="mp-note" style="font-size: 11px; height: 24px;">Aucune date dans la chronologie : renseigner les dates des étapes pour afficher la frise.</div>
    {% endif %}

    <div class="mp-cards" style="grid-template-columns: repeat({{ per }}, minmax(0, 1fr)); grid-template-rows: repeat({{ v.rows|length }}, minmax(0, 1fr));">
      {% for c in x.cartes %}
      <div class="mp-c{% if c.incertain %} inc{% endif %}">
        <div class="cb" data-fit="6" data-max="{{ 10 if two else 11.5 }}" data-group="mpc">
          <div class="d">{{ c.date }}{% if c.rel %}<small>{{ c.rel }}</small>{% endif %}</div>
          <div class="p">{{ c.lieu }}</div>
          <div class="e">{{ c.titre }}</div>
          {% if c.desc and not two %}<div class="x">{{ c.desc }}</div>{% endif %}
          {% for ch in c.chips %}<div class="ch{% if not ch.warn %} info{% endif %}">{{ '⚠ ' if ch.warn }}{{ ch.t }}</div>{% endfor %}
          {% if c.personnes %}<div class="q">? personnes présentes</div>{% endif %}
        </div>
        <div class="mp-pill" style="background: {{ c.r.c }};">{{ c.r.s }} {{ c.r.t }}</div>
      </div>
      {% else %}
      <div class="mp-note">Aucune étape dans la chronologie.</div>
      {% endfor %}
    </div>

    <div class="mp-bottom">
      <div class="mp-box">
        <div class="mp-sec">Contacts <small>{{ x.contacts.resume }}</small></div>
        <div class="mp-body" data-fit="6.5" data-max="11.5" data-group="mpb">
          {% for g in x.contacts.lignes %}
          <div class="mp-row"><span class="n">{{ g.t }}</span><span class="mp-bar"><i style="width: {{ g.w }}%; background: {{ g.c }};"></i></span>
            {% if g.n is none %}<span class="v mp-todo">? à dénombrer</span>{% else %}<span class="v">{{ g.n }}{% if g.s is not none %} · {{ g.s }} suivis{% endif %}</span>{% endif %}</div>
          {% else %}
          <div class="mp-note">Aucun groupe de contacts renseigné.</div>
          {% endfor %}
        </div>
      </div>
      <div class="mp-box">
        <div class="mp-sec">PCI et décontamination <small>{{ x.pci.resume }}</small></div>
        <div class="mp-body" data-fit="6.5" data-max="11.5" data-group="mpb">
          {% for s in x.pci.sites %}
          <div class="mp-row"><span style="flex: 1; min-width: 0;">{{ s.t }}</span><span class="mp-st" style="background: {{ s.bg }}; color: {{ s.fg }};">{{ s.lib }}</span></div>
          {% endfor %}
          {% if x.pci.sans %}
          <div class="mp-todo" style="margin-top: .3em;">? {{ x.pci.sans|length }} lieu{{ 'x' if x.pci.sans|length > 1 }} d’exposition sans statut PCI :</div>
          <div class="mp-note">{{ x.pci.sans|join(' · ') }}</div>
          {% endif %}
          {% if x.pci.sites|rejectattr('st', 'equalto', 'Décontaminé')|list %}<div class="mp-note" style="margin-top: .3em;">Priorité : fermer les sites non décontaminés ; noter date, équipe et produit.</div>{% endif %}
        </div>
      </div>
      <div class="mp-box">
        <div class="mp-sec">Actions <small>{% if x.actions.auto %}suggérées, à valider{% else %}responsable · échéance{% endif %}</small></div>
        <div class="mp-body" data-fit="6" data-max="11.5" data-group="mpb">
          {% for a in x.actions.lignes %}
          <div class="mp-row"{% if a.fait %} style="opacity: .55;"{% endif %}>
            <span class="mp-st" style="background: {{ a.c }}; color: #fff; min-width: 5.6em; text-align: center;">{{ '✓ Fait' if a.fait else a.p }}</span>
            <span style="flex: 1; min-width: 0;">{{ a.t }}{% if a.cours %} <span class="mp-note">(en cours)</span>{% endif %}</span>
            {% if not x.actions.auto and not a.fait %}<span class="{{ '' if a.resp else 'mp-todo' }}" style="white-space: nowrap; font-size: .9em;">{{ a.resp or 'à désigner' }} · {{ a.ech or '—' }}</span>{% endif %}
          </div>
          {% else %}
          <div class="mp-note">Aucune action.</div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="mp-foot"><span><b>{{ v.org }}</b>{% if v.footer %} · {{ v.footer }}{% endif %}</span><span>{{ v.meta }}</span></div>
  </div>
</div>
