{# Mapping repensé (v1.8) : trois chiffres décisifs, frise à l'échelle du temps, étapes, Contacts / PCI / Actions.
   Page 1280 × 720 px. Le rouge = danger, l'orange = à compléter ; chaque couleur est doublée d'un symbole. #}
{% set x = v.v2 %}
{% set per = v.rows[0]|length if v.rows and v.rows[0]|length else 1 %}
{% set two = v.rows|length > 1 %}
<style>
.mp { background: #FFFFFF; color: #000000; }
.mp-head { position: absolute; left: 0; right: 0; top: 0; height: 70px; background: #12213B; color: #F7F5F0;
  display: flex; align-items: center; padding: 0 22px; gap: 16px; }
.mp-ttl { min-width: 0; flex: 1 1 auto; }
.mp-t1 { font-size: 20px; font-weight: 800; white-space: nowrap; overflow: hidden; }
.mp-t2 { font-size: 11.5px; color: #C9D3E2; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mp-hero { display: flex; gap: 8px; flex: none; }
.mp-k { border-radius: 9px; padding: 6px 12px; width: 168px; }
.mp-k .l { font-size: 8.5px; font-weight: 800; letter-spacing: .9px; text-transform: uppercase; opacity: .9; }
.mp-k .v { font-size: 19px; font-weight: 800; line-height: 1.15; margin-top: 1px; white-space: nowrap; overflow: hidden; }
.mp-k .s { font-size: 9px; opacity: .92; margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mp-tri { position: absolute; left: 0; right: 0; top: 70px; height: 4px; display: flex; }
.mp-tri i { flex: 1; }
.mp-dates { position: absolute; left: 0; right: 0; top: 74px; height: 28px; background: #FFFFFF; border-bottom: 1px solid #B8C0CC;
  display: flex; align-items: center; gap: 11px; padding: 0 22px; font-size: 10.5px; color: #000000; white-space: nowrap; }
.mp-dates b { color: #000000; }
.mp-miss { margin-left: auto; background: #FFF1DC; color: #8A4B00; border: 1px solid #F0C78A; border-radius: 999px;
  padding: 3px 10px; font-weight: 700; font-size: 10.5px; overflow: hidden; text-overflow: ellipsis; }
.mp-id { position: absolute; left: 22px; right: 22px; top: 80px; height: 46px; display: grid;
  grid-template-columns: repeat({{ v.identity|length }}, 1fr); background: #FFFFFF; border: 1px solid #B8C0CC; border-radius: 9px; }
.mp-id > div { display: flex; flex-direction: column; align-items: center; justify-content: center; border-left: 1px solid #B8C0CC;
  padding: 0 5px; min-width: 0; }
.mp-id > div:first-child { border-left: 0; }
.mp-id .k { font-size: 8px; letter-spacing: .5px; color: #000000; text-transform: uppercase; font-weight: 600; white-space: nowrap; }
.mp-id .v { font-size: 14px; font-weight: 800; margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; color: #000000; }
.mp-chrono { flex-wrap: nowrap; align-items: center !important; gap: 6px !important; }
.mp-badge { font-size: 9.5px; font-weight: 800; letter-spacing: .5px; text-transform: uppercase; padding: 4px 10px; border-radius: 5px; white-space: nowrap; }
.mp-badge.todo { background: #FFFFFF; color: #B3262C; box-shadow: inset 0 0 0 1.5px #B3262C; }
.mp-chrono .mp-miss { margin-left: 6px; font-size: 9.5px; letter-spacing: 0; text-transform: none; }
.mp-leg { margin-left: auto; white-space: nowrap; }
.mp-wrap { position: absolute; left: 0; right: 0; top: 128px; bottom: 0; padding: 8px 22px 6px; display: flex; flex-direction: column; gap: 7px; }
.mp-sec { font-size: 9.5px; font-weight: 800; letter-spacing: 1.1px; text-transform: uppercase; color: #12213B; display: flex; gap: 10px; align-items: baseline; }
.mp-sec small { font-size: 9px; font-weight: 600; letter-spacing: 0; text-transform: none; color: #000000; }
.mp-tl { position: relative; height: 44px; flex: none; margin: 0 4px; }
.mp-phases { display: grid; height: 44px; flex: none; gap: 3px; }
.mp-phases .ph { position: relative; display: flex; flex-direction: column; justify-content: center; padding: 0 15px 0 17px; min-width: 0;
  clip-path: polygon(0 0, calc(100% - 11px) 0, 100% 50%, calc(100% - 11px) 100%, 0 100%, 11px 50%); font-size: 8.6px; line-height: 1.2; }
.mp-phases .ph:first-child { clip-path: polygon(0 0, calc(100% - 11px) 0, 100% 50%, calc(100% - 11px) 100%, 0 100%); padding-left: 9px; border-radius: 5px 0 0 5px; }
.mp-phases .l1, .mp-phases .l2 { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mp-phases .l1 b { font-weight: 800; text-transform: uppercase; letter-spacing: .3px; }
.mp-phases .l2 { font-weight: 800; }
.mp-phases .l3 { font-weight: 500; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.mp-rows { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 6px; }
.mp-crow { flex: 1 1 0; min-height: 0; display: flex; flex-direction: column; gap: 3px; }
.mp-bands { display: grid; column-gap: 6px; height: 15px; flex: none; }
.mp-bd { border-radius: 4px; font-size: 8.5px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; display: flex;
  align-items: center; justify-content: center; white-space: nowrap; overflow: hidden; padding: 0 6px; }
.mp-band { position: absolute; top: 4px; height: 20px; border-radius: 4px; font-size: 9.5px; font-weight: 700; display: flex;
  align-items: center; padding: 0 6px; white-space: nowrap; overflow: hidden; }
.mp-gap { position: absolute; top: 0px; height: 14px; border: 1.5px dashed #C76A00; border-radius: 4px; background: #FFF6E8;
  color: #8A4B00; font-size: 8.5px; font-weight: 700; display: flex; align-items: center; justify-content: center; white-space: nowrap; overflow: hidden; }
.mp-line { position: absolute; left: 0; right: 0; top: 23px; height: 2px; background: #C9C2B3; }
.mp-dot { position: absolute; top: 18px; width: 11px; height: 11px; margin-left: -5.5px; border-radius: 50%; border: 2px solid #FFFFFF; }
.mp-tick { position: absolute; top: 29px; font-size: 8.5px; color: #000000; transform: translateX(-50%); white-space: nowrap; }
.mp-rep { position: absolute; top: 0; height: 27px; border-left: 1.5px solid #12213B; }
.mp-rep span { position: absolute; top: -1px; left: 4px; font-size: 8px; font-weight: 800; color: #12213B; background: #FFFFFF; padding: 0 2px; white-space: nowrap; }
.mp-cards { flex: 1 1 auto; min-height: 0; display: grid; gap: 6px; }
.mp-cards > .mp-c { min-height: 0; }
.mp-c { background: #FFFFFF; border: 1px solid #B8C0CC; border-radius: 8px; padding: 6px 7px 7px; display: flex; flex-direction: column;
  gap: 2px; min-width: 0; min-height: 0; overflow: hidden; }
.mp-c.inc { border-style: dashed; }
.mp-c .cb { flex: 1 1 auto; min-height: 0; overflow: hidden; font-size: 11px; display: flex; flex-direction: column; gap: .18em; }
.mp-c .d { font-size: .92em; font-weight: 800; color: #3E6FA8; line-height: 1.2; }
.mp-c .d small { color: #000000; font-weight: 700; margin-left: .3em; }
.mp-c .p { font-size: 1em; font-weight: 700; line-height: 1.2; }
.mp-c .e { font-size: .92em; color: #000000; line-height: 1.25; }
.mp-c .x { font-size: .82em; color: #000000; line-height: 1.25; }
.mp-c .q { font-size: .8em; color: #8A4B00; font-weight: 700; }
.mp-c .t { font-size: 1.02em; font-weight: 800; line-height: 1.15; margin: .05em 0 .1em; }
.mp-c .ic { width: 1.75em; height: 1.75em; border-radius: 50%; display: grid; place-items: center; margin: .2em 0 .1em; }
.mp-c .ic svg { width: 1.05em; height: 1.05em; }
.mp-c .chips { display: flex; flex-wrap: wrap; gap: .3em; margin-top: .2em; }
.mp-c .chip { display: inline-flex; align-items: center; gap: .3em; font-size: .78em; font-weight: 600; color: #1F3A5F;
  background: #EDF1F6; border-radius: 1em; padding: .2em .6em; line-height: 1.2; }
.mp-c .chip svg { width: 1.05em; height: 1.05em; flex: none; }
.mp-c .chip.warn { background: #FBEAE8; color: #8E1F24; }
.mp-c .chip.todo { background: #FFF1DC; color: #8A4B00; font-weight: 800; box-shadow: inset 0 0 0 1px #F0C78A; }
.mp-c .ch { font-size: .78em; color: #8E1F24; font-weight: 700; }
.mp-c .ch.info { color: #000000; font-weight: 600; }
.mp-pill { flex: none; color: #fff; font-size: {{ 8.5 if two else 9.5 }}px; font-weight: 800; border-radius: 5px; padding: {{ 2 if two else 3 }}px 4px;
  text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mp-bottom { flex: none; height: {{ 150 if two else 190 }}px; display: grid; grid-template-columns: 1.25fr 1fr 1.25fr; gap: 9px; }
.mp-box { background: #FFFFFF; border: 1px solid #B8C0CC; border-radius: 9px; padding: 8px 12px; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.mp-box .mp-sec { justify-content: space-between; align-items: center; margin-bottom: 7px; }
.mp-lab { display: inline-block; background: #1F3A5F; color: #FFFFFF; font-size: 9.5px; font-weight: 800; letter-spacing: 1px;
  text-transform: uppercase; padding: 4px 10px; border-radius: 5px; }
.ac-h { font-size: .8em; font-weight: 800; letter-spacing: .5px; text-transform: uppercase; border-radius: .4em; padding: .25em .6em;
  margin: .1em 0 .15em; align-self: stretch; }
.ac-h.todo { color: #B3262C; border: 1.5px solid #B3262C; }
.ac-h.done { color: #2E7D4F; border-top: 1px dashed #B8C0CC; border-radius: 0; padding: .45em 0 .1em; margin-top: .35em; }
.ac-ok { flex: none; width: 1.25em; height: 1.25em; border-radius: 50%; background: #2E7D4F; color: #fff; display: inline-grid;
  place-items: center; font-size: .8em; font-weight: 800; }
.mp-body { flex: 1 1 auto; min-height: 0; overflow: hidden; font-size: 11px; display: flex; flex-direction: column; gap: .32em; }
.mp-row { display: flex; align-items: center; gap: .7em; line-height: 1.2; }
.mp-row .n { width: 40%; flex: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mp-bar { flex: 1; height: .8em; background: #EEE9DE; border-radius: .4em; overflow: hidden; }
.mp-bar i { display: block; height: 100%; }
.mp-row .v { flex: none; min-width: 6.8em; text-align: right; font-weight: 800; white-space: nowrap; }
.mp-todo { color: #8A4B00; font-weight: 700; }
.mp-st { flex: none; font-size: .88em; font-weight: 800; border-radius: .4em; padding: .2em .55em; white-space: nowrap; }
.mp-note { color: #000000; font-size: .92em; line-height: 1.3; }
.mp-foot { flex: none; height: 16px; display: flex; justify-content: space-between; font-size: 8.5px; color: #000000; white-space: nowrap; gap: 12px; }
.mp-foot b { color: #12213B; }
</style>

<div class="page mapping mp">
  <div class="mp-head">
    <div class="mp-ttl">
      <div class="mp-t1" data-fit="12" data-max="20">{{ x.titre }}</div>
      <div class="mp-t2">{{ x.sous }}</div>
    </div>
    <div class="mp-hero">
      {% for k in x.hero %}
      <div class="mp-k" style="background: {{ k.bg }}; color: {{ k.fg }};">
        <div class="l">{{ k.k }}</div><div class="v" data-fit="11" data-max="19">{{ k.v }}</div><div class="s">{{ k.s }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="mp-tri"><i style="background:#1D5FAF"></i><i style="background:#C8202A"></i><i style="background:#F2B705"></i></div>
  <div class="mp-id">
    {% for c in v.identity %}<div{% if c.tip %} title="{{ c.tip }}"{% endif %}><span class="k">{{ c.k }}</span><span class="v"{% if c.color %} style="color: {{ c.color }}"{% endif %}>{{ c.v }}</span></div>{% endfor %}
  </div>

  <div class="mp-wrap">
    <div class="mp-sec mp-chrono"><span class="mp-lab">Chronologie du parcours</span>
      {% if v.contact %}<span class="mp-badge" style="background: {{ v.contact.fill }}; color: {{ v.contact.ink }};">{{ v.contact.t }}{% if v.contact.src %} {{ v.contact.src }}{% endif %}</span>{% if v.contact.todo %}<span class="mp-badge todo">ID du cas source : à compléter</span>{% endif %}{% endif %}
      {% for b in v.badges %}{% if b.todo %}<span class="mp-badge todo">{{ b.t }}</span>{% else %}<span class="mp-badge" style="background: {{ b.fill }}; color: {{ b.ink }};">{{ b.t }}</span>{% endif %}{% endfor %}
      {% if x.manque %}<span class="mp-miss">? {{ x.manque|join(' · ') }}</span>{% endif %}
      <small class="mp-leg">J±n : jours depuis le J0 {% if v.recul %}retenu (date rapportée − {{ v.recul }} j){% else %}retenu ou estimé{% endif %}{% if x.frise and x.frise.adapte %} · jours chargés agrandis{% endif %}</small></div>
    {% if v.phase_strip %}
    <div class="mp-phases" style="grid-template-columns: repeat({{ v.phase_strip|length }}, minmax(0,1fr));">
      {% for p in v.phase_strip %}
      <div class="ph" style="background: {{ p.fill }}; color: {{ p.fill|ink }};" title="{{ p.label }} : {{ p.dates }} : {{ p.detail }}">
        <span class="l1"><b>{{ loop.index }}. {{ p.label }}</b> · {{ p.contag }}</span>
        <span class="l2">{{ p.dates }}</span>
        <span class="l3">{{ p.detail }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if x.frise %}
    <div class="mp-tl">
      {% if x.frise.trou %}<div class="mp-gap" style="left: {{ x.frise.trou.l }}%; width: calc({{ x.frise.trou.w }}% - 2px);">{{ x.frise.trou.t }}</div>{% endif %}
      <div class="mp-line"></div>
      {% for r in x.frise.reperes %}<div class="mp-rep" style="left: {{ r.x }}%;"><span>{{ r.t }}</span></div>{% endfor %}
      {% for p in x.frise.points %}<div class="mp-dot" style="left: {{ p.x }}%; background: {{ p.c }};" title="{{ p.t }}"></div>{% endfor %}
      {% for t in x.frise.ticks %}<div class="mp-tick" style="left: {{ t.x }}%;">{{ t.t }}</div>{% endfor %}
    </div>
    {% else %}
    <div class="mp-note" style="font-size: 11px; height: 24px;">Aucune date dans la chronologie : renseigner les dates des étapes pour afficher la frise.</div>
    {% endif %}

    <div class="mp-rows">
    {% for row in v.rows %}{% set r0 = loop.index0 * per %}
      <div class="mp-crow">
        <div class="mp-bands" style="grid-template-columns: repeat({{ per }}, minmax(0, 1fr));">
          {% for b in v.bands[loop.index0] %}{% set bc = t.PHASES[b.phase].color|soft %}<div class="mp-bd" style="grid-column: {{ b.col }} / span {{ b.span }}; background: {{ bc }}; color: {{ bc|ink }};">{{ b.label }}</div>{% endfor %}
        </div>
        <div class="mp-cards" style="grid-template-columns: repeat({{ per }}, minmax(0, 1fr));">
      {% for c in x.cartes[r0:r0 + row|length] %}
      <div class="mp-c{% if c.incertain %} inc{% endif %}">
        <div class="mp-cbar" style="background: {{ c.tc }};"></div>
        <div class="cb" data-fit="6" data-max="{{ 10 if two else 11.5 }}" data-group="mpc">
          <div class="d" style="color: {{ c.tc }};">{{ c.date }}{% if c.rel %}<small>{{ c.rel }}</small>{% endif %}</div>
          <div class="p">{{ c.lieu }}</div>
          <span class="ic" style="background: {{ c.tc }};">{{ c.icon|safe }}</span>
          <div class="t">{{ c.titre }}</div>
          {% if c.desc and not two %}<div class="x">{{ c.desc }}</div>{% endif %}
          {% if c.chips or c.personnes %}<div class="chips">
            {% for ch in c.chips %}<span class="chip{% if ch.warn %} warn{% endif %}">{{ ch.icon|safe }}{{ ch.t }}</span>{% endfor %}
            {% if c.personnes %}<span class="chip todo">{{ x.icone_personnes|safe }}? personnes présentes</span>{% endif %}
          </div>{% endif %}
        </div>
        <div class="mp-pill" style="background: {{ c.r.c }};">{{ c.r.s }} {{ c.r.t }}</div>
      </div>
      {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="mp-note">Aucune étape dans la chronologie.</div>
    {% endfor %}
    </div>

    <div class="mp-bottom">
      <div class="mp-box">
        <div class="mp-sec"><span class="mp-lab">Contacts à identifier / suivre</span> <small>{{ x.contacts.resume }}</small></div>
        <div class="mp-body" data-fit="6.5" data-max="11.5" data-group="mpb">
          {% for g in x.contacts.lignes %}
          <div class="mp-row"><span class="n">{{ g.t }}</span><span class="mp-bar"><i style="width: {{ g.w }}%; background: {{ g.c }};"></i></span>
            {% if g.n is none %}<span class="v mp-todo">? à dénombrer</span>{% else %}<span class="v">{{ g.n }}{% if g.s is not none %} · {{ g.s }} suivis{% endif %}</span>{% endif %}</div>
          {% else %}
          <div class="mp-note">Aucun groupe de contacts renseigné.</div>
          {% endfor %}
        </div>
      </div>
      <div class="mp-box">
        <div class="mp-sec"><span class="mp-lab">PCI / décontamination</span> <small>{{ x.pci.resume }}</small></div>
        <div class="mp-body" data-fit="6.5" data-max="11.5" data-group="mpb">
          {% for s in x.pci.sites %}
          <div class="mp-row"><span style="flex: 1; min-width: 0;">{{ s.t }}</span><span class="mp-st" style="background: {{ s.bg }}; color: {{ s.fg }};">{{ s.lib }}</span></div>
          {% endfor %}
          {% if x.pci.sans %}
          <div class="mp-todo" style="margin-top: .3em;">? {{ x.pci.sans|length }} lieu{{ 'x' if x.pci.sans|length > 1 }} d’exposition sans statut PCI :</div>
          <div class="mp-note">{{ x.pci.sans|join(' · ') }}</div>
          {% endif %}
          {% if x.pci.sites|rejectattr('st', 'equalto', 'Décontaminé')|list %}<div class="mp-note" style="margin-top: .3em;">Priorité : fermer les sites non décontaminés ; noter date, équipe et produit.</div>{% endif %}
        </div>
      </div>
      <div class="mp-box">
        <div class="mp-sec"><span class="mp-lab">Actions</span> <small>{% if x.actions.auto %}suggérées, à valider{% else %}responsable · échéance{% endif %}</small></div>
        <div class="mp-body" data-fit="6" data-max="11.5" data-group="mpb">
          {% set afaire = x.actions.lignes|rejectattr('fait')|list %}
          {% set faites = x.actions.lignes|selectattr('fait')|list %}
          {% if afaire %}
          {% if not x.actions.auto %}<div class="ac-h todo">À réaliser immédiatement</div>{% endif %}
          {% for a in afaire %}
          <div class="mp-row">
            <span class="mp-st" style="background: {{ a.c }}; color: #fff; min-width: 5.6em; text-align: center;">{{ a.p }}</span>
            <span style="flex: 1; min-width: 0;">{{ a.t }}{% if a.cours %} <span class="mp-note">(en cours)</span>{% endif %}</span>
            {% if not x.actions.auto %}<span class="{{ '' if a.resp else 'mp-todo' }}" style="white-space: nowrap; font-size: .9em;">{{ a.resp or 'à désigner' }} · {{ a.ech or '—' }}</span>{% endif %}
          </div>
          {% endfor %}
          {% endif %}
          {% if faites %}
          <div class="ac-h done">Déjà réalisées</div>
          {% for a in faites %}
          <div class="mp-row"><span class="ac-ok">✓</span><span style="flex: 1; min-width: 0;">{{ a.t }}</span></div>
          {% endfor %}
          {% endif %}
          {% if not afaire and not faites %}<div class="mp-note">Aucune action.</div>{% endif %}
        </div>
      </div>
    </div>

    <div class="mp-foot"><span><b>{{ v.org }}</b>{% if v.footer %} · {{ v.footer }}{% endif %}</span><span>{{ v.meta }}</span></div>
  </div>
</div>
<style>
/* cartes des étapes : barre de couleur du type en haut, contenu centré (demande de la riposte) */
.mp-c { padding: 0 0 7px !important; text-align: center; }
.mp-cbar { height: 4px; flex: none; }
.mp-c .cb { padding: 6px 7px 0; align-items: center; }
.mp-c .d { font-weight: 800; }
.mp-c .chips { justify-content: center; }
.mp-c .mp-pill { margin: 0 7px; }
</style>
