{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mapping Épi : lancer l'application",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Mapping Épi : serveur web (réseau local)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/serveur_web.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Mapping Épi : tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q",
        "tests"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}